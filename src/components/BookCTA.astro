---
import { BOOK, hasAmazonLink } from "../data/book";
interface Props {
  variant?: "post" | "home";
}
const { variant = "post" } = Astro.props;
---

<aside class={`book-cta book-cta--${variant}`} aria-label="About the book">
  <div class="book-cta__cover" aria-hidden={BOOK.cover ? undefined : "true"}>
    {
      BOOK.cover ? (
        <img
          src={BOOK.cover}
          alt={`Cover of ${BOOK.title}`}
          width="160"
          height="240"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="book-cta__placeholder">
          <>
            <span>The</span>
            <span>Hyperconnected</span>
            <span>Self</span>
          </>
        </div>
      )
    }
  </div>
  <div class="book-cta__text">
    <p class="book-cta__eyebrow">The Book</p>
    <h2 class="book-cta__title">{BOOK.title}</h2>
    <p class="book-cta__hook">{BOOK.hook}</p>
    <p class="book-cta__blurb">{BOOK.blurb}</p>
    <div class="book-cta__actions">
      {
        hasAmazonLink && (
          <a
            href={BOOK.amazonUrl}
            class="btn-primary"
            rel="noopener noreferrer"
            target="_blank"
          >
            Get it on Amazon
          </a>
        )
      }
      <a href="/books/the-hyperconnected-self/" class="btn">About the book</a>
    </div>
  </div>
</aside>
<style>
  .book-cta {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    align-items: center;
    border: 1px solid var(--border);
    background: var(--bg-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-block: 3rem;
  }
  .book-cta--home {
    margin-block: 0;
    border-left: none;
    border-right: none;
    background: var(--bg-alt);
  }
  .book-cta__cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  .book-cta__placeholder {
    aspect-ratio: 2 / 3;
    border: 1px solid var(--border-hover);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    font-family: var(--font-serif);
    color: var(--heading);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.5rem;
  }
  .book-cta__eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .book-cta__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 0.5rem;
  }
  .book-cta__hook {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--accent-warm);
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }
  .book-cta__blurb {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    max-width: 56ch;
  }
  .book-cta__actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  @media (max-width: 560px) {
    .book-cta {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .book-cta__cover {
      max-width: 140px;
      margin-inline: auto;
    }
    .book-cta__blurb {
      margin-inline: auto;
    }
    .book-cta__actions {
      justify-content: center;
    }
  }
</style>
