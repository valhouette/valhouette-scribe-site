---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blogs", ({ data }) => !data.draft);
const recent = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

function fmt(d: Date): string {
  return d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title="Valhouette Scribe"
  description="Writing and resources for digitally saturated adults who sense their inner life has become crowded, filtered, or externally shaped."
>
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container container--content hero__inner">
      <p class="hero__eyebrow">Welcome To</p>
      <h1 class="hero__title">Valhouette Scribe.</h1>
      <div class="divider" aria-hidden="true"></div>
      <p class="hero__body">The depth of presence in a hyperconnected world</p>
      <div class="hero__actions">
        <a href="/blog/" class="btn-primary">Read the Essays</a>
        <a href="/quizzes/" class="btn">Take a Quiz</a>
      </div>
    </div>
  </section>

  <!-- ── Recent Writing ── -->
  {
    recent.length > 0 && (
      <section class="section section--alt recent-posts">
        <div class="container container--wide">
          <div class="section-head">
            <h2 class="section-head__title">Recent Essays</h2>
            <a href="/blog/" class="text-link">
              All Essays &rarr;
            </a>
          </div>

          <div class="post-list">
            {recent.map((post) => (
              <article class="post-item">
                <time
                  class="post-item__date"
                  datetime={post.data.publishDate.toISOString()}
                >
                  {fmt(post.data.publishDate)}
                </time>
                <h3 class="post-item__title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p class="post-item__desc">{post.data.description}</p>
                <a href={`/blog/${post.id}/`} class="text-link">
                  Read &rarr;
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── Quiz Callout ── -->
  <section class="section quiz-callout">
    <div class="container container--content quiz-callout__inner">
      <div class="divider" aria-hidden="true"></div>
      <h2 class="quiz-callout__title">Self-Reflective Quizzes</h2>
      <p class="quiz-callout__body">
        The essays name the patterns. These quizzes help you map them in a
        quieter way: private, local to your device, and designed to bring your
        attention back to your own signals rather than to the feed.
      </p>
      <a href="/quizzes/" class="btn">Take a Quiz</a>
      <div class="divider" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(5rem, 12vw, 9rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 50% 40%,
      rgba(181, 169, 142, 0.07) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .hero__title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.08;
    margin-bottom: 0;
  }
  .hero__body {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: var(--muted);
    line-height: 1.85;
    max-width: 56ch;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }
  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Section alt bg */
  .section--alt {
    background: var(--bg-alt);
  }

  /* Section header */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.1rem;
    margin-bottom: 2.5rem;
  }
  .section-head__title {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
  }

  /* Post list */
  .post-list {
    display: grid;
    gap: 0;
  }
  .post-item {
    padding-block: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .post-item:last-child {
    border-bottom: none;
  }
  .post-item__date {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .post-item__title {
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .post-item__title a {
    color: var(--heading);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .post-item__title a:hover {
    color: var(--accent-warm);
  }
  .post-item__desc {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 1rem;
    max-width: 64ch;
  }

  /* Quiz callout */
  .quiz-callout {
    background: var(--bg);
  }
  .quiz-callout__inner {
    text-align: center;
  }
  .quiz-callout__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    margin-bottom: 1.25rem;
  }
  .quiz-callout__body {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 2rem;
    max-width: 52ch;
    margin-inline: auto;
    margin-bottom: 2rem;
  }
</style>
